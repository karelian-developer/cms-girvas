<div class="sideblock__mini-cabinet mini-cabinet" data-element="mini-cabinet">
  <div class="mini-cabinet__left-column">
    <img src="{USER_AVATAR_URL}" alt="{USER_LOGIN}" class="mini-cabinet__avatar">
  </div>
  <div class="mini-cabinet__right-column">
    <h4 class="mini-cabinet__user-login">{USER_LOGIN}</h4>
    <div class="mini-cabinet__infobase">
      <div class="mini-cabinet__infobase-label">
        Группа
      </div>
      <div class="mini-cabinet__infobase-value">
        {USER_GROUP_LABEL}
      </div>
    </div>
    <div class="mini-cabinet__panel">
      <button data-element="mini-cabinet-button-profile" class="mini-cabinet__panel-button">Профиль</button>
      <button data-element="mini-cabinet-button-exit" class="mini-cabinet__panel-button">Выйти</button>
    </div>
  </div>
</div>
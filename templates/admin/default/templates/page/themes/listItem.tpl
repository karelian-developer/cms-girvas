<li class="list__item item" data-name="{THEME_NAME}" data-category="{THEME_CATEGORY_NAME}" data-installed-status="{THEME_INSTALLED_STATUS}">
  <div class="item__icon-container" style="background-image: url('{THEME_PREVIEW_URL}');"></div>
  <div class="item__body-container">
    <h2 class="item__title">
      <a href="{THEME_LINK}" class="item__title-link">{THEME_TITLE}</a>
    </h2>
    <div class="item__description">{THEME_DESCRIPTION}</div>
  </div>
  <div class="item__footer-container" data-element="item-footer-panel"></div>
</li>
<li class="list__item item" data-name="{MODULE_NAME}" data-installed-status="{MODULE_INSTALLED_STATUS}" data-enabled-status="{MODULE_ENABLED_STATUS}">
  <div class="item__icon-container" style="background-image: url('{MODULE_PREVIEW_URL}');"></div>
  <div class="item__body-container">
    <h2 class="item__title">
      <a href="{MODULE_LINK}" class="item__title-link">{MODULE_TITLE}</a>
    </h2>
    <div class="item__description">{MODULE_DESCRIPTION}</div>
  </div>
  <div class="item__footer-container" data-element="item-footer-panel"></div>
</li>
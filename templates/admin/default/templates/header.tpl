<header class="header">
  <div class="header__container container">
    <div class="header__brand-container brand-container">
      <picture class="header__brand-image brand-image">
        <img src="/images/brand_system_96.png" alt="{CMS_TITLE}">
      </picture>
    </div>
    <div class="header__system system">
      <div class="system__info info">
        <div class="info__data data">
          <div class="data__label label">Версия</div>
          <div class="data__value value">{CMS_VERSION_LABEL}</div>
        </div>
        <div class="info__data data">
          <div class="data__label label">Пользователь</div>
          <div class="data__value value"><b>{CLIENT_USER_LOGIN}</b> ({CLIENT_USER_GROUP_TITLE})</div>
        </div>
      </div>
    </div>
    <div class="header__buttons-container buttons-container" id="SYSTEM_E3724126421"></div>
  </div>
</header>
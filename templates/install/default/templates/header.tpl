<header class="header">
  <section class="header__section section">
    <div class="header__installer-progress-container container">
      <ul class="header__installer-progress installer-progress" role="installer-progress"></ul>
    </div>
    <div class="header__container container">
      <div class="header__brand-container">
        <img src="{SITE_TEMPLATE_URL}/images/brand-header.webp" alt="CMS «GIRVAS»" class="header__brand-image">
      </div>
      <div class="header__title-container">
        <h1 class="header__title">{LANG:INSTALLER_TITLE}</h1>
        <div class="header__copyright-container copyright-container">
          <p class="copyright-container__phar phar"><b>{CMS_DEVELOPER_TITLE}</b></p>
          <p class="copyright-container__phar phar"><b>{LANG:INSTALLER_VERSION_CMS_LABEL}:</b> {CMS_VERSION_LABEL}</p>
          <p class="copyright-container__phar phar">&copy;&nbsp;2021&nbsp;&mdash;&nbsp;2025</p>
        </div>
      </div>
    </div>
  </section>
</header>